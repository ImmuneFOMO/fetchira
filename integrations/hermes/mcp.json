{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "fetchira": {
      "type": "stdio",
      "command": "fetchira",
      "args": ["serve"],
      "env": {
        "FETCHIRA_MANAGED_BY": "hermes",
        "FETCHIRA_DISABLE": "chatgpt_web,gemini_web,grok_web,create_image",
        "FETCHIRA_HOME": "${PLUGIN_DATA}/home",
        "SERPER_API_KEY": "${SERPER_API_KEY}",
        "TAVILY_API_KEY": "${TAVILY_API_KEY}",
        "EXA_API_KEY": "${EXA_API_KEY}",
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}",
        "PARALLEL_API_KEY": "${PARALLEL_API_KEY}",
        "STEEL_API_KEY": "${STEEL_API_KEY}",
        "TINYFISH_API_KEY": "${TINYFISH_API_KEY}",
        "LINKUP_API_KEY": "${LINKUP_API_KEY}",
        "YOU_API_KEY": "${YOU_API_KEY}",
        "OCTEN_API_KEY": "${OCTEN_API_KEY}",
        "NIMBLE_API_KEY": "${NIMBLE_API_KEY}",
        "SERPAPI_API_KEY": "${SERPAPI_API_KEY}",
        "LANGSEARCH_API_KEY": "${LANGSEARCH_API_KEY}",
        "SCRAPINGANT_API_KEY": "${SCRAPINGANT_API_KEY}",
        "ZENROWS_API_KEY": "${ZENROWS_API_KEY}",
        "HYPERBROWSER_API_KEY": "${HYPERBROWSER_API_KEY}",
        "BROWSERLESS_API_KEY": "${BROWSERLESS_API_KEY}"
      }
    }
  }
}
