# Copy to /etc/fetchira/hosted.env and chmod 600. Do not put real secrets in git.

# Public hostname (TLS terminator / Caddy). The unit binds loopback below.
FETCHIRA_HOST=fetchira.example.com
FETCHIRA_BIND=127.0.0.1:7879
FETCHIRA_HOME=/var/lib/fetchira
RUST_LOG=fetchira=info

# Admin password: leave unset for first-visit setup in /admin, or an Argon2id
# hash from `fetchira server password hash`.
# FETCHIRA_ADMIN_PASSWORD=
# FETCHIRA_ADMIN_PASSWORD_FILE=/etc/fetchira/admin-password

# Master key: `head -c 48 /dev/urandom | base64 | tr -d '\n'`
# Losing it makes encrypted provider credentials unrecoverable.
# FETCHIRA_MASTER_KEY=
# FETCHIRA_MASTER_KEY_FILE=/etc/fetchira/master-key
